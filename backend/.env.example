# --- Database (Devansh) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuskart?retryWrites=true&w=majority
DB_MAX_POOL=10
DB_MIN_POOL=2
# --- Cloudinary (Devansh) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abc...xyz
CLOUDINARY_FOLDER=campuskart
# --- Backend (Deepakshi) ---
JWT_SECRET=a_very_long_random_string
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
PORT=5000
NODE_ENV=development
# Browser origin(s) allowed by CORS. Comma-separated for several. Default is Vite's dev server.
FRONTEND_URL=http://localhost:5173
# --- Weeks 4–7 (Devansh) ---
# Embeddings for semantic search (same HF token as ml-service; server-side only)
HF_TOKEN=hf_replace-with-your-token
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=huggingface   # default when HF_TOKEN is set; "hash" = offline test vectors (not semantic); "none" = off
# Admin analytics day boundaries
ANALYTICS_TZ=Asia/Kolkata
# Where npm run db:backup writes (keep outside Git)
BACKUP_DIR=backups
