# --- Database (Devansh) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuskart?retryWrites=true&w=majority
DB_MAX_POOL=10
DB_MIN_POOL=2
# Only for mongodb+srv:// lookups that fail on some networks: DNS servers to use ("system" = OS default)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# --- Cloudinary (Devansh) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abc...xyz
CLOUDINARY_FOLDER=campuskart
# --- Backend (Deepakshi) ---
JWT_SECRET=a_very_long_random_string
JWT_EXPIRES_IN=7d
# Roshni's FastAPI ML service (ml-service/). The marketplace keeps working when it is down; AI endpoints answer 503.
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent to the ML service as x-ml-api-key. Required when the ML service runs with APP_ENV=production;
# use the same value on both services (generate with: openssl rand -hex 32)
# ML_API_KEY=generate-a-long-random-string
# On macOS, port 5000 is taken by AirPlay Receiver: use 5001 there (and point VITE_API_URL at it)
PORT=5000
# production also turns on app.set("trust proxy", 1) for the rate limiter behind Render's proxy
NODE_ENV=development
# Browser origin(s) allowed by CORS. Comma-separated for several. Default is Vite's dev server.
FRONTEND_URL=http://localhost:5173
# --- Weeks 4–7 (Devansh) ---
# Optional: only for Atlas vector-search embeddings (npm run db:embeddings). Smart search works without it;
# the ML service ranks by meaning with a free local model and needs no HF_TOKEN. Server-side only.
HF_TOKEN=hf_replace-with-your-token
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=huggingface   # default when HF_TOKEN is set; "hash" = offline test vectors (not semantic); "none" = off
# EMBEDDING_CONCURRENCY=2          # parallel embedding requests in the background queue
# EMBEDDING_TEST_DELAY_MS=3000     # only used by npm run db:embeddings:test
# Admin analytics day boundaries
ANALYTICS_TZ=Asia/Kolkata
# Where npm run db:backup writes (keep outside Git)
BACKUP_DIR=backups
