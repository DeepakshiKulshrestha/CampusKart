PORT=8000
APP_ENV=development
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set HF_TOKEN as a server-side secret with Inference Providers permission. Never put it in browser code.
# HF_TOKEN=hf_replace-with-your-token
MODEL_STORAGE_ROOT=./model_artifacts
PRICE_MODEL_PATH=./model_artifacts/price/current/model.joblib
FRAUD_MODEL_PATH=./model_artifacts/fraud/current/model.joblib
# Required in production; use a long randomly generated value and set the same value in Node.
# ML_API_KEY=replace-with-a-long-random-secret
# Optional paths for a persistent host volume. Keep generated model artifacts out of Git.
# PRICE_MODEL_PATH=/data/model.joblib
